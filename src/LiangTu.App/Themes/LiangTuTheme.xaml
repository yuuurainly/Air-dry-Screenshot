<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BitmapImage x:Key="ApplicationIconImage"
                 UriSource="pack://application:,,,/LiangTu;component/Assets/liangtu.ico"
                 CacheOption="OnLoad" />
    <Color x:Key="Color.Canvas">#F5F5F2</Color>
    <Color x:Key="Color.Surface">#FBFCFA</Color>
    <Color x:Key="Color.SurfaceRaised">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceMuted">#ECEFEC</Color>
    <Color x:Key="Color.SurfaceHover">#F0F2EF</Color>
    <Color x:Key="Color.Ink">#25282D</Color>
    <Color x:Key="Color.InkSecondary">#777D84</Color>
    <Color x:Key="Color.Border">#DDE0E3</Color>
    <Color x:Key="Color.BorderStrong">#C9CED2</Color>
    <Color x:Key="Color.BorderHover">#A6ADB0</Color>
    <Color x:Key="Color.DarkSurface">#252A30</Color>
    <Color x:Key="Color.DarkSurfaceRaised">#30363D</Color>
    <Color x:Key="Color.DarkBorder">#3A4047</Color>
    <Color x:Key="Color.DarkText">#F3F5F2</Color>
    <Color x:Key="Color.DarkTextSecondary">#A7AEB5</Color>
    <Color x:Key="Color.EditorCanvas">#171B19</Color>
    <Color x:Key="Color.Accent">#77BFB0</Color>
    <Color x:Key="Color.AccentHover">#68B3A3</Color>
    <Color x:Key="Color.AccentPressed">#5AA293</Color>
    <Color x:Key="Color.AccentSoft">#E7F3EF</Color>
    <Color x:Key="Color.Rope">#E1DFD4</Color>
    <Color x:Key="Color.RopeShadow">#68706B</Color>
    <Color x:Key="Color.Danger">#B65F5F</Color>
    <Color x:Key="Color.White">#FFFFFF</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource Color.SurfaceMuted}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource Color.InkSecondary}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource Color.BorderHover}" />
    <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource Color.DarkSurface}" />
    <SolidColorBrush x:Key="DarkSurfaceRaisedBrush" Color="{StaticResource Color.DarkSurfaceRaised}" />
    <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource Color.DarkBorder}" />
    <SolidColorBrush x:Key="DarkTextBrush" Color="{StaticResource Color.DarkText}" />
    <SolidColorBrush x:Key="DarkTextSecondaryBrush" Color="{StaticResource Color.DarkTextSecondary}" />
    <SolidColorBrush x:Key="EditorCanvasBrush" Color="{StaticResource Color.EditorCanvas}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="RopeBrush" Color="{StaticResource Color.Rope}" />
    <SolidColorBrush x:Key="RopeShadowBrush" Color="{StaticResource Color.RopeShadow}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="WhiteHairlineBrush" Color="#55FFFFFF" />
    <SolidColorBrush x:Key="OverlayHitTestBrush" Color="#01FFFFFF" />
    <SolidColorBrush x:Key="HotZoneHitBrush" Color="#01000000" />
    <SolidColorBrush x:Key="ScreenDimBrush" Color="#44000000" />
    <SolidColorBrush x:Key="ScreenSelectionFillBrush" Color="#10171A17" />
    <SolidColorBrush x:Key="WindowHighlightFillBrush" Color="#12000000" />
    <SolidColorBrush x:Key="DarkHoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="DarkSelectionBrush" Color="#2277BFB0" />
    <SolidColorBrush x:Key="FloatingPillBrush" Color="#B8252A30" />
    <SolidColorBrush x:Key="FloatingPillBorderBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="CardEdgeBrush" Color="#D9FFFFFF" />
    <LinearGradientBrush x:Key="GlassInnerBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F5FFFFFF" />
        <GradientStop Offset="0.52" Color="#E8F4F3EE" />
        <GradientStop Offset="1" Color="#A8D9E0DB" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassOuterBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#D06A767D" />
        <GradientStop Offset="0.32" Color="#D0475259" />
        <GradientStop Offset="0.72" Color="#C4374046" />
        <GradientStop Offset="1" Color="#B6252B30" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#B8FFFFFF" />
        <GradientStop Offset="0.36" Color="#3DFFFFFF" />
        <GradientStop Offset="0.72" Color="#08FFFFFF" />
        <GradientStop Offset="1" Color="#46FFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassSelectionBrush" Color="#D9F4F7F1" />
    <SolidColorBrush x:Key="GlassFrameFillBrush" Color="#38252A30" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <LinearGradientBrush x:Key="ClothespinBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#D1A477" />
        <GradientStop Offset="0.52" Color="#B78759" />
        <GradientStop Offset="1" Color="#8E603F" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ClothespinGrooveBrush" Color="#8C543923" />
    <SolidColorBrush x:Key="ClothespinSeamBrush" Color="#7A6A452D" />
    <SolidColorBrush x:Key="ClothespinSpringBrush" Color="#756A625B" />
    <SolidColorBrush x:Key="ClothespinHighLightBrush" Color="#66FFF4E7" />

    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Microsoft YaHei UI</FontFamily>

    <Thickness x:Key="PagePadding">32</Thickness>
    <Thickness x:Key="SectionPadding">0,22,0,22</Thickness>
    <Thickness x:Key="CardPadding">18</Thickness>
    <Thickness x:Key="ControlPadding">11,8</Thickness>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="DarkCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="BadgeCornerRadius">9</CornerRadius>

    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="18"
                      Direction="270"
                      ShadowDepth="4"
                      Opacity="0.11"
                      Color="#1B2220"
                      x:Shared="False" />
    <DropShadowEffect x:Key="SoftWindowShadow"
                      BlurRadius="24"
                      Direction="270"
                      ShadowDepth="7"
                      Opacity="0.15"
                      Color="#111714"
                      x:Shared="False" />
    <DropShadowEffect x:Key="FloatingControlShadow"
                      BlurRadius="12"
                      Direction="270"
                      ShadowDepth="2"
                      Opacity="0.10"
                      Color="#1B2220"
                      x:Shared="False" />
    <DropShadowEffect x:Key="HoverCardShadow"
                      BlurRadius="23"
                      Direction="270"
                      ShadowDepth="6"
                      Opacity="0.17"
                      Color="#161D19"
                      x:Shared="False" />
    <DropShadowEffect x:Key="RopeCardShadow"
                      BlurRadius="18"
                      Direction="270"
                      ShadowDepth="5"
                      Opacity="0.20"
                      Color="#111713"
                      x:Shared="False" />
    <DropShadowEffect x:Key="HotZoneShadow"
                      BlurRadius="5"
                      Direction="270"
                      ShadowDepth="1"
                      Opacity="0.25"
                      Color="#101713"
                      x:Shared="False" />

    <Style x:Key="BaseWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="Icon" Value="{StaticResource ApplicationIconImage}" />
        <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="ButtonRoot"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonRoot" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonRoot" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource DarkSurfaceBrush}" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="QuietButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DarkQuietButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DarkTextSecondaryBrush}" />
        <Setter Property="Padding" Value="10,5" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DarkHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingsTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleSwitchStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Track"
                                Width="38"
                                Height="22"
                                CornerRadius="11">
                            <Border.Background>
                                <SolidColorBrush Color="{StaticResource Color.BorderStrong}" />
                            </Border.Background>
                            <Border Width="16"
                                    Height="16"
                                    Margin="3"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    CornerRadius="8">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" X="0" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4"
                                                      Direction="270"
                                                      ShadowDepth="1"
                                                      Opacity="0.16"
                                                      Color="#202521" />
                                </Border.Effect>
                            </Border>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          ContentSource="Content" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="16"
                                                         Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.Accent}"
                                                        Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.14">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Track"
                                                        Storyboard.TargetProperty="Background.Color"
                                                        To="{StaticResource Color.BorderStrong}"
                                                        Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{StaticResource DarkSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="11" />
    </Style>
</ResourceDictionary>
