<Window x:Class="LiangTu.App.Windows.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LiangTu.App.Controls"
        Title="图片库 · 晾图"
        Width="1040"
        Height="740"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="34,23,34,15">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PageTitleStyle}"
                               FontSize="30"
                               Text="图片库" />
                    <Border Margin="10,3,0,0"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="{StaticResource BadgeCornerRadius}">
                        <TextBlock x:Name="CountText"
                                   Foreground="{StaticResource InkSecondaryBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   Text="0" />
                    </Border>
                </StackPanel>
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource CaptionStyle}"
                           Text="本机图片" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock x:Name="SelectionText"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionStyle}" />
                <Button x:Name="DeleteSelectedButton"
                        Width="96"
                        Foreground="{StaticResource DangerBrush}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="False"
                        Click="DeleteSelected_Click"
                        Content="删除" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <ListBox x:Name="AssetList"
                         Margin="27,24,27,24"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionMode="Extended"
                         SelectionChanged="AssetList_SelectionChanged"
                         KeyDown="AssetList_KeyDown"
                         MouseDoubleClick="AssetList_MouseDoubleClick">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="7" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="SelectionShell"
                                                Padding="3"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionShell"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}" />
                                                <Setter TargetName="SelectionShell"
                                                        Property="Background"
                                                        Value="{StaticResource AccentSoftBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SelectionShell"
                                                        Property="Background"
                                                        Value="{StaticResource SurfaceHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="218"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CardCornerRadius}"
                                    ClipToBounds="True">
                                <Border.Effect>
                                    <StaticResource ResourceKey="CardShadow" />
                                </Border.Effect>
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="复制" Click="Copy_Click" />
                                        <MenuItem Header="预览" Click="Preview_Click" />
                                        <MenuItem Header="标注" Click="Edit_Click" />
                                        <MenuItem Header="贴到桌面" Click="Pin_Click" />
                                        <Separator />
                                        <MenuItem Header="挂到晾衣绳" Click="Promote_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="142" />
                                        <RowDefinition Height="54" />
                                    </Grid.RowDefinitions>
                                    <controls:RoundedImage Margin="1"
                                                           Source="{Binding Thumbnail}"
                                                           CornerRadius="7"
                                                           BorderBrush="{StaticResource CardEdgeBrush}"
                                                           BorderThickness="1" />
                                    <Grid Grid.Row="1" Margin="12,7,11,7">
                                        <StackPanel>
                                            <TextBlock Foreground="{StaticResource InkBrush}"
                                                       FontSize="10"
                                                       Text="{Binding ModifiedText}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{StaticResource InkSecondaryBrush}"
                                                       FontSize="9"
                                                       Text="{Binding SourceText}" />
                                        </StackPanel>
                                        <TextBlock HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Foreground="{StaticResource InkSecondaryBrush}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="9"
                                                   Text="{Binding Dimensions}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkSecondaryBrush}"
                           FontSize="13"
                           Text="图片库还是空的"
                           Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
