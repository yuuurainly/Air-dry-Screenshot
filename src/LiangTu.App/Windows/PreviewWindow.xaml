<Window x:Class="LiangTu.App.Windows.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="预览"
        Width="1080"
        Height="760"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindowStyle}"
        Background="{StaticResource EditorCanvasBrush}">
    <Grid>
        <ScrollViewer x:Name="ImageScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ImageScroll_PreviewMouseWheel">
            <Grid Background="{StaticResource EditorCanvasBrush}">
                <Image x:Name="PreviewImage"
                       Margin="24"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                    </Image.LayoutTransform>
                </Image>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
