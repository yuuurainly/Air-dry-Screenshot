<Window x:Class="LiangTu.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 晾图"
        Width="820"
        Height="840"
        MinWidth="760"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Style="{StaticResource BaseWindowStyle}">
    <Window.Resources>
        <Style x:Key="ShortcutTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource SettingsTextBoxStyle}">
            <Setter Property="Width" Value="172" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>
        <Style x:Key="SettingsDividerStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="0,20" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource DarkSurfaceBrush}">
            <Grid Margin="26,28,24,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Foreground="{StaticResource DarkTextBrush}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Text="晾图" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="11"
                               Text="设置" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                    <Border Width="34"
                            Height="2"
                            HorizontalAlignment="Left"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="1" />
                    <TextBlock Margin="0,14,0,0"
                               Foreground="{StaticResource DarkTextSecondaryBrush}"
                               FontSize="11"
                               LineHeight="18"
                               Text="所有图片保存在本机。&#x0a;设置更改会在保存后立即生效。" />
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Margin="0,20,0,0"
                           x:Name="VersionText"
                           Foreground="{StaticResource DarkTextSecondaryBrush}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10"
                           Text="v1.0.0" />
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="34,27,34,10">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="设置" />
                <TextBlock Margin="0,6,0,0"
                           Style="{StaticResource CaptionStyle}"
                           Text="管理图片、自动隐藏与快捷键。" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="34,0,22,0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,5,12,26">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="保存位置" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="截图、剪贴板图片和手动导入都保存到这里。" />
                    <Grid Margin="0,11,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DirectoryBox"
                                 Style="{StaticResource SettingsTextBoxStyle}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="Browse_Click"
                                Content="浏览" />
                    </Grid>

                    <Border Style="{StaticResource SettingsDividerStyle}" />

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="自动行为" />
                    <Grid Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="自动隐藏晾衣绳" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="交互期间暂停；离开后继续剩余时间。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="18,0,0,0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBox x:Name="AutoHideSecondsBox"
                                     Width="66"
                                     Style="{StaticResource SettingsTextBoxStyle}"
                                     TextAlignment="Right" />
                            <TextBlock Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="秒" />
                        </StackPanel>
                        <CheckBox x:Name="AutoHideCheck"
                                  Grid.Column="2"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="AutoHideCheck_Changed"
                                  Unchecked="AutoHideCheck_Changed" />
                    </Grid>

                    <Border Style="{StaticResource SettingsDividerStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="自动收集剪贴板图片" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="只处理图片，忽略普通文本。" />
                        </StackPanel>
                        <CheckBox x:Name="AutoCollectCheck"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsDividerStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="垂落与回弹动画" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="遵循 Windows 的减少动态效果设置。" />
                        </StackPanel>
                        <CheckBox x:Name="RopeAnimationCheck"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsDividerStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabelStyle}"
                                       Text="开机启动" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource CaptionStyle}"
                                       Text="登录 Windows 后自动启动晾图。" />
                        </StackPanel>
                        <CheckBox x:Name="StartupCheck"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ToggleSwitchStyle}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsDividerStyle}" />

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="快捷键" />
                    <TextBlock Margin="0,5,0,0"
                               Style="{StaticResource CaptionStyle}"
                               Text="使用修饰键组合或单功能键，例如 Alt+S、F1。" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabelStyle}"
                                   Text="区域截图" />
                        <TextBox x:Name="RegionHotkeyBox"
                                 Grid.Column="1"
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ShortcutTextBoxStyle}" />

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="窗口截图" />
                        <TextBox x:Name="WindowHotkeyBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ShortcutTextBoxStyle}" />

                        <TextBlock Grid.Row="2"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="剪贴板贴图" />
                        <TextBox x:Name="PinHotkeyBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Style="{StaticResource ShortcutTextBoxStyle}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="34,14"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="82"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            Content="取消" />
                    <Button Width="88"
                            Margin="8,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"
                            Content="保存" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
