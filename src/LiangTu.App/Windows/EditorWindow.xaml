<Window x:Class="LiangTu.App.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标注 · 晾图"
        Width="1120"
        Height="780"
        MinWidth="760"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource BaseWindowStyle}"
        Background="{StaticResource DarkSurfaceBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Foreground" Value="{StaticResource DarkTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource DarkHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource DarkSurfaceBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Swatch"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource WhiteHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="10" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch"
                                        Property="BorderBrush"
                                        Value="{StaticResource DarkTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Swatch" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource DarkSurfaceBrush}"
                BorderBrush="{StaticResource DarkBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Toolbar_MouseLeftButtonDown">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="2,0,18,0"
                               Foreground="{StaticResource DarkTextBrush}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Text="标注" />
                    <RadioButton x:Name="PenTool"
                                 GroupName="Tools"
                                 Tag="Pen"
                                 IsChecked="True"
                                 Content="画笔"
                                 ToolTip="画笔"
                                 Style="{StaticResource ToolbarButtonStyle}"
                                 Checked="Tool_Checked" />
                    <RadioButton GroupName="Tools"
                                 Tag="Arrow"
                                 Content="箭头"
                                 ToolTip="箭头"
                                 Style="{StaticResource ToolbarButtonStyle}"
                                 Checked="Tool_Checked" />
                    <RadioButton GroupName="Tools"
                                 Tag="Rectangle"
                                 Content="矩形"
                                 ToolTip="矩形"
                                 Style="{StaticResource ToolbarButtonStyle}"
                                 Checked="Tool_Checked" />
                    <RadioButton GroupName="Tools"
                                 Tag="Text"
                                 Content="文字"
                                 ToolTip="文字"
                                 Style="{StaticResource ToolbarButtonStyle}"
                                 Checked="Tool_Checked" />
                    <RadioButton GroupName="Tools"
                                 Tag="Mosaic"
                                 Content="马赛克"
                                 ToolTip="马赛克"
                                 Style="{StaticResource ToolbarButtonStyle}"
                                 Checked="Tool_Checked" />

                    <Border Width="1"
                            Height="22"
                            Margin="11,0,13,0"
                            Background="{StaticResource DarkBorderBrush}" />
                    <Button Tag="#E05A5A"
                            Background="#E05A5A"
                            ToolTip="红色"
                            Style="{StaticResource ColorSwatchButtonStyle}"
                            Click="Color_Click" />
                    <Button Tag="#F2C94C"
                            Background="#F2C94C"
                            ToolTip="黄色"
                            Style="{StaticResource ColorSwatchButtonStyle}"
                            Click="Color_Click" />
                    <Button Tag="#77BFB0"
                            Background="#77BFB0"
                            ToolTip="青绿色"
                            Style="{StaticResource ColorSwatchButtonStyle}"
                            Click="Color_Click" />
                    <Button Tag="#5A8DEE"
                            Background="#5A8DEE"
                            ToolTip="蓝色"
                            Style="{StaticResource ColorSwatchButtonStyle}"
                            Click="Color_Click" />
                    <Slider x:Name="ToolSizeSlider"
                            Width="86"
                            Margin="8,0,0,0"
                            Minimum="2"
                            Maximum="24"
                            Value="5"
                            VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource DarkQuietButtonStyle}"
                            Click="Undo_Click"
                            Content="撤销" />
                    <Button Style="{StaticResource DarkQuietButtonStyle}"
                            Click="Redo_Click"
                            Content="重做" />
                    <Button Margin="5,0,0,0"
                            Style="{StaticResource DarkQuietButtonStyle}"
                            Click="Cancel_Click"
                            Content="取消" />
                    <Button Width="78"
                            Margin="5,0,0,0"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Save_Click"
                            Content="保存" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ImageArea"
                Grid.Row="1"
                Margin="14,12,14,10"
                Background="{StaticResource EditorCanvasBrush}"
                CornerRadius="{StaticResource CardCornerRadius}"
                ClipToBounds="True"
                SizeChanged="ImageArea_SizeChanged">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="CanvasHost"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Image x:Name="BaseImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Canvas x:Name="OverlayCanvas"
                            Background="{StaticResource OverlayHitTestBrush}"
                            ClipToBounds="True"
                            Cursor="Cross"
                            MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                            MouseMove="OverlayCanvas_MouseMove"
                            MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="18,0">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource DarkTextSecondaryBrush}"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10"
                       VerticalAlignment="Center" />
            <TextBlock HorizontalAlignment="Right"
                       Foreground="{StaticResource DarkTextSecondaryBrush}"
                       FontSize="10"
                       VerticalAlignment="Center"
                       Text="Esc 取消" />
        </Grid>
    </Grid>
</Window>
