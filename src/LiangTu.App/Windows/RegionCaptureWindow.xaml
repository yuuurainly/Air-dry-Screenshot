<Window x:Class="LiangTu.App.Windows.RegionCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="区域截图"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Cursor="Cross"
        Style="{StaticResource BaseWindowStyle}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonDown="Window_MouseRightButtonDown"
        KeyDown="Window_KeyDown">
    <Grid x:Name="Root" ClipToBounds="True">
        <Image x:Name="BackgroundImage"
               Stretch="Fill"
               Opacity="0.72" />
        <Border Background="{StaticResource ScreenDimBrush}" />
        <Border x:Name="SelectionBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="2"
                Background="{StaticResource ScreenSelectionFillBrush}"
                CornerRadius="2"
                Visibility="Collapsed" />
        <Border Margin="16"
                Padding="12,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{StaticResource DarkSurfaceBrush}"
                BorderBrush="{StaticResource DarkBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource ControlCornerRadius}">
            <TextBlock Foreground="{StaticResource DarkTextBrush}"
                       FontSize="12"
                       Text="拖动选择 · Esc 取消" />
        </Border>
    </Grid>
</Window>
